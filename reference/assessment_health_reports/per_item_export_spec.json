  ],
  "notes_templates": {
   "early_middle": {
    "Good": "Low relative pressure signal. As this item is outside the final 25%, interpret the index as a comparative omission/performance diagnostic rather than direct evidence of test speededness.",
    "Review": "Moderate relative pressure signal. As this item is outside the final 25%, review item difficulty, wording, omission, and response time; the result alone is not evidence of time pressure.",
    "Flag": "High relative pressure signal. As this item is outside the final 25%, investigate item difficulty, wording, omission, and response time; do not interpret the result alone as test speededness."
   },
   "late": {
    "Good": "Low item-level time-pressure signal relative to the assessment's early-item baseline; interpret together with item difficulty, wording, and response time.",
    "Review": "Moderate item-level time-pressure signal; review together with item difficulty, wording, omission, and response-time evidence.",
    "Flag": "Possible item-level time-pressure signal; later position coincides with a marked accuracy decline and/or higher omission relative to the assessment's early-item baseline."
   }
  }
