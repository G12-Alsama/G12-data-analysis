  "conditional_formatting": [
   {
    "range": "N5:N<last>",
    "rules": [
     [
      "AND(ISNUMBER(N5),N5<=0.05)",
      "good"
     ],
     [
      "AND(ISNUMBER(N5),N5>0.05,N5<=0.15)",
      "review"
     ],
     [
      "AND(ISNUMBER(N5),N5>0.15)",
      "flag"
     ]
    ]
   },
   {
    "range": "P5:P<last>",
    "rules": [
     [
      "P5<=0.05",
      "good"
     ],
     [
      "AND(P5>0.05,P5<=0.1)",
      "review"
     ],
     [
      "P5>0.1",
      "flag"
     ]
    ]
   },
   {
    "range": "Q5:Q<last>",
    "rules": [
     [
      "Q5>=0.95",
      "good"
     ],
     [
      "AND(Q5>=0.9,Q5<0.95)",
      "review"
     ],
     [
      "Q5<0.9",
      "flag"
     ]
    ]
   }
  ],
